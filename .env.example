# Cadena de conexión de Neon (PostgreSQL).
# Se usa SOLO en las funciones serverless (api/) y en scripts/poll.ts.
# Nunca debe llevar prefijo VITE_ ni exponerse en el frontend.
# Ejemplo: postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Secreto usado para derivar el hash HMAC del identificador de navegador.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cambiarlo invalida los identificadores ya emitidos (los invitados podrían votar otra vez).
VOTE_HASH_PEPPER=

# Sólo desarrollo local. Permite repetir votos para probar todos los estados.
# El servidor lo ignora si NODE_ENV es production o VERCEL_ENV es production/preview.
# En Vercel NO se configura.
VOTE_DEV_MODE=true
